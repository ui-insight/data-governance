        {"name": "Source_Transcript_ID", "type": "string nullable"},
        {"name": "Actors", "type": "array<Actor>"},
        {"name": "Systems", "type": "array<System> nullable"},
        {"name": "Steps", "type": "array<Step>"},
        {"name": "UDM_Entities", "type": "array<string> nullable"},
