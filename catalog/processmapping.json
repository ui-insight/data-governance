{
  "application": "ProcessMapping",
  "repository": "https://github.com/ui-insight/ProcessMapping",
  "domain": "Process Intelligence",
  "runtime_modes": [
    "json",
    "insight_db"
  ],
  "tech_stack": {
    "backend": "FastAPI + Pydantic",
    "frontend": "React + TypeScript + Vite",
    "database": "Optional PostgreSQL projection via insight-db"
  },
  "canonical_assets": [
    "processes/*/process.json",
    "processes/*/metadata.json",
    "workflows/*/workflow.json",
    "workflows/*/extraction-tasks/*.md",
    "data/allowed_values.json",
    "transcripts/raw/*"
  ],
  "entity_count": 9,
  "process_map_count": 15,
  "workflow_count": 11,
  "prompt_file_count": 52,
  "projection_table_count": 1,
  "entities": [
