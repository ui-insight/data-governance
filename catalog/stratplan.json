{
  "application": "StratPlan Tactics Dashboard",
  "repository": "https://github.com/ui-insight/StratPlanTacticsMB",
  "domain": "Strategic Planning",
  "runtime_modes": [
    "json",
    "insight_db"
  ],
  "tech_stack": {
    "backend": "FastAPI",
    "frontend": "React + JSX + Custom CSS",
    "database": "Optional PostgreSQL projection via insight-db"
  },
  "data_source": "backend/app/data/strategic_plan_data.json",
  "entity_count": 6,
  "projection_table_count": 10,
  "entities": [
    {
      "name": "Pillar",
      "description": "Top-level strategic pillar",
      "count": 5,
      "fields": [
        {"name": "code", "type": "string"},
        {"name": "name", "type": "string"},
        {"name": "priorities", "type": "dict<string,string>"}
      ]
    },
    {
      "name": "Priority",
      "description": "Strategic objective within a pillar",
      "count": 20,
      "fields": [
        {"name": "code", "type": "string (e.g. A.1)"},
        {"name": "description", "type": "string"}
      ],
      "parent": "Pillar"
    },
    {
      "name": "Unit",
      "description": "University organizational unit",
      "count": 25,
      "fields": [
        {"name": "unit_name", "type": "string"},
        {"name": "source_files", "type": "array<string>"},
        {"name": "alignment_metadata", "type": "AlignmentMetadata"}
      ]
    },
    {
      "name": "Tactic",
      "description": "Specific action aligned to one or more priorities",
      "count": 385,
      "fields": [
        {"name": "id", "type": "integer"},
        {"name": "tactic_text", "type": "string"},
        {"name": "pillar", "type": "string"},
        {"name": "priority_code", "type": "string"},
        {"name": "priority_codes", "type": "array<PriorityCodeMapping>"},
        {"name": "metrics", "type": "array<string>"},
        {"name": "timeline", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "execution_status", "type": "string nullable"},
        {"name": "percent_complete", "type": "integer nullable"},
        {"name": "has_metrics_defined", "type": "boolean nullable"},
        {"name": "last_update_date", "type": "date nullable"},
        {"name": "update_note", "type": "string nullable"},
        {"name": "funding_source", "type": "string nullable"},
        {"name": "fy_budget_range", "type": "string nullable"},
        {"name": "roi_type", "type": "string nullable"},
        {"name": "expected_roi_timeline", "type": "string nullable"},
        {"name": "horizon_category", "type": "string nullable"},
        {"name": "alignment_level", "type": "string nullable"}
      ],
      "parent": "Unit"
    },
    {
      "name": "PriorityCodeMapping",
      "description": "Junction between tactic and priority with confidence",
      "fields": [
        {"name": "code", "type": "string"},
        {"name": "confidence", "type": "string"},
        {"name": "source", "type": "string"}
      ],
      "parent": "Tactic"
    },
    {
      "name": "SPIGPAward",
      "description": "Strategic plan implementation grant",
      "count": 3,
      "fields": [
        {"name": "award_id", "type": "string"},
        {"name": "lead_pi", "type": "string"},
        {"name": "lead_unit", "type": "string"},
        {"name": "pillar", "type": "string"},
        {"name": "total_award", "type": "number"},
        {"name": "status", "type": "string"},
        {"name": "percent_complete", "type": "integer"},
        {"name": "roi_type", "type": "string nullable"},
        {"name": "linked_tactic_ids", "type": "array<integer>"}
      ]
    }
  ],
  "controlled_vocabularies": {
    "pillar_code": ["A", "B", "C", "D", "E"],
    "alignment_level": ["explicit_subpillar", "mixed", "pillar_only"],
    "priority_code_confidence": ["explicit", "inferred", "pillar_only"],
    "execution_status": ["not_started", "in_progress", "completed", "delayed_at_risk"],
    "funding_source": ["spigp", "base", "philanthropy", "external", "unfunded"],
    "roi_type": ["revenue", "retention", "efficiency", "compliance", "reputation"],
    "horizon_category": ["quick_wins", "mid_term", "long_term", "ongoing_operations"],
    "spigp_status": ["not_started", "in_progress", "completed", "delayed_at_risk"]
  }
}
